{
  "compilerOptions": {
    "target": "ES2020",                        // ⬅️ necesario para scripts modernos
    "module": "commonjs",                      // ⬅️ importante para usar con ts-node
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "LEGADO/ChecklistCompleto",
    "script/**/*.ts"       // ⬅️ incluye scripts personalizados
  ],
  "exclude": ["node_modules"]
}


